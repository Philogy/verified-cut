#!/usr/bin/env python3
"""Stand-in for the Lean `vericut` CLI while it is being written, so the app can be
built against the contract (app/dev/README.md). Not verified: ffmpeg does the decoding,
trimming and FLAC encoding. Point the app at it with VERICUT_BIN=app/dev/vericut-stub.

  vericut probe <file.wav|file.flac>
  vericut peaks <file> <buckets>
  vericut export <timeline.json> <out.flac> [--level N]
"""
import array
import json
import os
import struct
import subprocess
import sys
import time


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def ffmpeg():
    # GUI apps get a bare PATH, so look in the usual Homebrew places.
    for p in [os.environ.get("FFMPEG"), "/opt/homebrew/bin/ffmpeg", "/usr/local/bin/ffmpeg"]:
        if p and os.access(p, os.X_OK):
            return p
    return "ffmpeg"


def probe_flac(path):
    with open(path, "rb") as f:
        if f.read(4) != b"fLaC":
            die(f"{path}: not a FLAC file")
        hdr = f.read(4)
        if len(hdr) < 4 or hdr[0] & 0x7F != 0:
            die(f"{path}: FLAC without STREAMINFO")
        si = f.read(34)
    # STREAMINFO bytes 10..17: rate (20 bits), channels-1 (3), bits-1 (5), total samples (36).
    v = int.from_bytes(si[10:18], "big")
    return {
        "sampleRate": v >> 44,
        "channels": ((v >> 41) & 0x7) + 1,
        "bitsPerSample": ((v >> 36) & 0x1F) + 1,
        "samples": v & ((1 << 36) - 1),
        "format": "flac",
    }


def probe_wav(path):
    # By hand rather than with `wave`, which (before Python 3.12) rejects WAVE_FORMAT_EXTENSIBLE,
    # the header ffmpeg writes for 24-bit audio.
    with open(path, "rb") as f:
        f.read(12)
        fmt = None
        while True:
            hdr = f.read(8)
            if len(hdr) < 8:
                die(f"{path}: WAV without fmt/data chunks")
            cid, size = hdr[:4], struct.unpack("<I", hdr[4:])[0]
            if cid == b"fmt ":
                body = f.read(size + (size & 1))
                tag, ch, rate, _, align, bits = struct.unpack("<HHIIHH", body[:16])
                if tag == 0xFFFE and len(body) >= 26:
                    tag = struct.unpack("<H", body[24:26])[0]
                if tag != 1:
                    die(f"{path}: unsupported WAV encoding {tag:#x}; only integer PCM is read")
                fmt = (rate, ch, bits, align)
            elif cid == b"data":
                if fmt is None:
                    die(f"{path}: WAV data before fmt")
                rate, ch, bits, align = fmt
                return {"sampleRate": rate, "channels": ch, "bitsPerSample": bits,
                        "samples": size // align, "format": "wav"}
            else:
                f.seek(size + (size & 1), 1)


def probe(path):
    try:
        with open(path, "rb") as f:
            magic = f.read(12)
    except OSError as e:
        die(f"{path}: {e.strerror}")
    if magic[:4] == b"fLaC":
        return probe_flac(path)
    if magic[:4] == b"RIFF" and magic[8:12] == b"WAVE":
        return probe_wav(path)
    die(f"{path}: not WAV or FLAC")


def cmd_probe(args):
    if len(args) != 1:
        die("usage: vericut probe <file>")
    print(json.dumps(probe(args[0])))


def cmd_peaks(args):
    if len(args) != 2:
        die("usage: vericut peaks <file> <buckets>")
    path, buckets = args[0], int(args[1])
    info = probe(path)
    n, ch = info["samples"], info["channels"]
    buckets = max(1, min(buckets, n)) if n else 0
    p = subprocess.Popen([ffmpeg(), "-v", "error", "-i", path,
                          "-af", "pan=mono|c0=" + "+".join(f"{1 / ch:.6f}*c{k}" for k in range(ch)), "-f", "s16le", "-acodec", "pcm_s16le", "-"],
                         stdout=subprocess.PIPE)
    lo, hi = [], []
    buf = array.array("h")
    for i in range(buckets):
        end = (i + 1) * n // buckets
        start = i * n // buckets
        while len(buf) < end - start:
            chunk = p.stdout.read(1 << 20)
            if not chunk:
                break
            buf.frombytes(chunk[: len(chunk) // 2 * 2])
        part = buf[: end - start]
        del buf[: end - start]
        lo.append(round(min(part) / 32768, 4) if part else 0.0)
        hi.append(round(max(part) / 32768, 4) if part else 0.0)
    p.stdout.close()
    p.wait()
    print(json.dumps({"min": lo, "max": hi}))


def cmd_export(args):
    level = 5
    if "--level" in args:
        i = args.index("--level")
        level = int(args[i + 1])
        del args[i : i + 2]
    if len(args) != 2 or not 0 <= level <= 8:
        die("usage: vericut export <timeline.json> <out.flac> [--level 0..8]")
    t0 = time.monotonic()
    with open(args[0]) as f:
        clips = json.load(f)["clips"]
    if not clips:
        die("timeline has no clips")
    fmt = None
    for k, c in enumerate(clips):
        p = probe(c["src"])
        this = (p["sampleRate"], p["channels"], p["bitsPerSample"])
        if fmt is None:
            fmt = this
        for name, a, b in zip(["sample rate", "channels", "bits per sample"], this, fmt):
            if a != b:
                die(f"clip {k + 1} ({c['src']}): {name} {a} differs from the first clip's {b}")
        if not 0 <= c["in"] < c["out"] <= p["samples"]:
            die(f"clip {k + 1}: range [{c['in']}, {c['out']}) outside [0, {p['samples']})")
    graph = "".join(f"[{k}:a]atrim=start_sample={c['in']}:end_sample={c['out']},asetpts=PTS-STARTPTS[a{k}];"
                    for k, c in enumerate(clips))
    graph += "".join(f"[a{k}]" for k in range(len(clips))) + f"concat=n={len(clips)}:v=0:a=1[out]"
    fmtargs = ["-sample_fmt", "s16"] if fmt[2] <= 16 else ["-sample_fmt", "s32", "-bits_per_raw_sample", str(fmt[2])]
    cmd = [ffmpeg(), "-v", "error", "-y"]
    for c in clips:
        cmd += ["-i", c["src"]]
    cmd += ["-filter_complex", graph, "-map", "[out]", "-c:a", "flac", "-compression_level", str(level), *fmtargs, args[1]]
    r = subprocess.run(cmd, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        die(r.stderr.strip() or f"ffmpeg exited with {r.returncode}")
    out = probe(args[1])
    print(json.dumps({"samples": out["samples"], "bytes": os.path.getsize(args[1]),
                      "ms": int((time.monotonic() - t0) * 1000)}))


def main():
    cmds = {"probe": cmd_probe, "peaks": cmd_peaks, "export": cmd_export}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        die("usage: vericut probe|peaks|export ...")
    cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
